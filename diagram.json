{
  "version": 1,
  "author": "Matheus Vinicius Vidal de Andrade",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-s3-devkitc-1", "id": "esp", "top": 0, "left": 0, "attrs": { "env": "micropython-20231227-v1.22.0", "flashSize": "8" } },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr1", "top": -150, "left": 200, "attrs": { "lux": 500 } },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": -50, "left": 400, "attrs": { "color": "blue", "label": "Reset" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "ldr1:VCC", "esp:3V3.1", "red", [] ],
    [ "ldr1:GND", "esp:GND.1", "black", [] ],
    [ "ldr1:DO", "esp:4", "green", [] ],
    [ "btn1:1.l", "esp:15", "green", [] ],
    [ "btn1:2.l", "esp:GND.1", "black", [] ]
  ]
}
